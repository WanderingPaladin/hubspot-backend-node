# HubSpot authentication (use a Private App token; do not commit real values)
HUBSPOT_ACCESS_TOKEN=
# Legacy alias — treated as a Bearer token if HUBSPOT_ACCESS_TOKEN is unset
HUBSPOT_API_KEY=

# Official HubSpot API host
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Deal pipeline / stage (official properties: pipeline, dealstage)
# Default portal values often work: pipeline=default, dealstage=appointmentscheduled
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_ID=appointmentscheduled

# HTTP client
HUBSPOT_TIMEOUT_MS=15000
HUBSPOT_MAX_RETRIES=4
HUBSPOT_RETRY_BASE_MS=500

# Express handler
PORT=3000
